{
  "env": {
    "MONGODB_URI": {
      "description": "MongoDB connection string",
      "required": true,
      "example": "mongodb+srv://username:password@cluster.mongodb.net/database"
    },
    "MONGODB_DB": {
      "description": "MongoDB database name",
      "required": true,
      "example": "clickclickjob"
    }
  }
} 